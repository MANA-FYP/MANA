<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mana_position</name>
  <version>0.1.0</version>
  <description>MANA position (M2): GPS, the lidar map or odometry as the position source.</description>
  <maintainer email="184832252+mushi0541@users.noreply.github.com">Mushahid Hussain</maintainer>
  <license>AGPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>mana_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-hypothesis</test_depend>
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
