<?xml version="1.0"?>
<!--
  The first test host: a wheelchair with a wheels mode and a tracks mode.

  The chassis carries two undercarriages on vertical slides:
    - four driven wheels (wheel_lift, a slide on the wheel carrier), and
    - two tracks (track_lift_left and track_lift_right).
  Only one set touches the ground. In wheels mode the wheels are down and the tracks are lifted
  15 cm; in tracks mode it is the other way round. The host node (mana_sim/host_node.py) follows
  the core's DriveRequest: it moves the slides and drives the set that is down.

  Wheels (r = 0.15 m) cannot climb a step of 12 cm; the tracks can. That is the point of the mode.
  The tracks do not yet climb a 17 cm step (the step height of the scripted world); see the README.

  Topics (gz transport, bridged to ROS 2 by the launch file):
    /model/mana_chair/wheels_cmd_vel      Twist for the wheels (DiffDrive)
    /model/mana_chair/tracks_cmd_vel      Twist for the tracks (TrackedVehicle)
    /model/mana_chair/joint/wheel_lift/cmd_pos        0.0 = wheels down, 0.35 = wheels up (clear of the stairs)
    /model/mana_chair/joint/track_lift_left/cmd_pos   0.0 = tracks down, 0.15 = tracks up
    /model/mana_chair/joint/track_lift_right/cmd_pos  same, right track
    /model/mana_chair/ground_truth      where the chair really is (the tracks and the wheels also publish their own odometry)
-->
<sdf version="1.9">
  <model name="mana_chair">
    <pose>0 0 0.38 0 0 0</pose>

    <!-- chassis: 0.9 m long, 0.34 m wide, 0.2 m high, with a seat block for the look of it -->
    <link name="chassis">
      <inertial>
        <mass>25</mass>
        <inertia>
          <ixx>1.2</ixx><iyy>3.0</iyy><izz>3.4</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.9 0.34 0.2</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>0.9 0.34 0.2</size></box></geometry>
        <material>
          <ambient>0.15 0.25 0.6 1</ambient><diffuse>0.2 0.35 0.8 1</diffuse>
        </material>
      </visual>
      <visual name="seat_visual">
        <pose>-0.1 0 0.22 0 0 0</pose>
        <geometry><box><size>0.45 0.3 0.25</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <visual name="back_visual">
        <pose>-0.32 0 0.5 0 0 0</pose>
        <geometry><box><size>0.06 0.3 0.4</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- ===== wheels: one carrier on a slide, four wheels on the carrier ===== -->
    <link name="wheel_carrier">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.05</ixx><iyy>0.05</iyy><izz>0.05</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
    </link>
    <joint name="wheel_lift" type="prismatic">
      <parent>chassis</parent>
      <child>wheel_carrier</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0</lower><upper>0.35</upper><effort>3000</effort><velocity>0.3</velocity></limit>
        <dynamics><damping>200</damping></dynamics>
      </axis>
    </joint>

    <!-- four wheels: front/rear, left/right; radius 0.15 m, centre 0.22 m under the carrier -->
    <link name="wheel_fl">
      <pose>0.32 0.35 -0.22 -1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0185</ixx><iyy>0.0185</iyy><izz>0.0169</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="wheel_fr">
      <pose>0.32 -0.35 -0.22 -1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0185</ixx><iyy>0.0185</iyy><izz>0.0169</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="wheel_rl">
      <pose>-0.32 0.35 -0.22 -1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0185</ixx><iyy>0.0185</iyy><izz>0.0169</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="wheel_rr">
      <pose>-0.32 -0.35 -0.22 -1.5708 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0185</ixx><iyy>0.0185</iyy><izz>0.0169</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.15</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <joint name="wheel_fl_joint" type="revolute">
      <parent>wheel_carrier</parent><child>wheel_fl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_fr_joint" type="revolute">
      <parent>wheel_carrier</parent><child>wheel_fr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_rl_joint" type="revolute">
      <parent>wheel_carrier</parent><child>wheel_rl</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="wheel_rr_joint" type="revolute">
      <parent>wheel_carrier</parent><child>wheel_rr</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- ===== tracks: one link per side, each on its own slide. The belt is flat; the front and the
         rear end slope up at 25 degrees, so the track can ride up a step. ===== -->
    <link name="left_track">
      <pose>0 0.24 -0.28 0 0 0</pose>
      <inertial>
        <mass>20</mass>
        <inertia><ixx>0.1</ixx><iyy>1.0</iyy><izz>1.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="belt">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.7 0.1 0.18</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode></friction></surface>
      </collision>
      <collision name="front_incline">
        <pose>0.601 0 0.082 0 -0.44 0</pose>
        <geometry><box><size>0.6 0.1 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode></friction></surface>
      </collision>
      <collision name="rear_incline">
        <pose>-0.601 0 0.082 0 0.44 0</pose>
        <geometry><box><size>0.6 0.1 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="belt_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.7 0.1 0.18</size></box></geometry>
        <material><ambient>0.7 0.4 0.05 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
      </visual>
      <visual name="front_incline_visual">
        <pose>0.601 0 0.082 0 -0.44 0</pose>
        <geometry><box><size>0.6 0.1 0.1</size></box></geometry>
        <material><ambient>0.7 0.4 0.05 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
      </visual>
      <visual name="rear_incline_visual">
        <pose>-0.601 0 0.082 0 0.44 0</pose>
        <geometry><box><size>0.6 0.1 0.1</size></box></geometry>
        <material><ambient>0.7 0.4 0.05 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="track_lift_left" type="prismatic">
      <parent>chassis</parent><child>left_track</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0</lower><upper>0.15</upper><effort>3000</effort><velocity>0.3</velocity></limit>
        <dynamics><damping>200</damping></dynamics>
      </axis>
    </joint>
    <link name="right_track">
      <pose>0 -0.24 -0.28 0 0 0</pose>
      <inertial>
        <mass>20</mass>
        <inertia><ixx>0.1</ixx><iyy>1.0</iyy><izz>1.0</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="belt">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.7 0.1 0.18</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode></friction></surface>
      </collision>
      <collision name="front_incline">
        <pose>0.601 0 0.082 0 -0.44 0</pose>
        <geometry><box><size>0.6 0.1 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode></friction></surface>
      </collision>
      <collision name="rear_incline">
        <pose>-0.601 0 0.082 0 0.44 0</pose>
        <geometry><box><size>0.6 0.1 0.1</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>150</mu2><fdir1>0 1 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="belt_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><box><size>0.7 0.1 0.18</size></box></geometry>
        <material><ambient>0.7 0.4 0.05 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
      </visual>
      <visual name="front_incline_visual">
        <pose>0.601 0 0.082 0 -0.44 0</pose>
        <geometry><box><size>0.6 0.1 0.1</size></box></geometry>
        <material><ambient>0.7 0.4 0.05 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
      </visual>
      <visual name="rear_incline_visual">
        <pose>-0.601 0 0.082 0 0.44 0</pose>
        <geometry><box><size>0.6 0.1 0.1</size></box></geometry>
        <material><ambient>0.7 0.4 0.05 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="track_lift_right" type="prismatic">
      <parent>chassis</parent><child>right_track</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>0</lower><upper>0.15</upper><effort>3000</effort><velocity>0.3</velocity></limit>
        <dynamics><damping>200</damping></dynamics>
      </axis>
    </joint>

    <!-- ===== plugins ===== -->
    <!-- hold the three slides at the position the host node asks for -->
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>wheel_lift</joint_name>
      <topic>/model/mana_chair/joint/wheel_lift/cmd_pos</topic>
      <p_gain>20000</p_gain><i_gain>0</i_gain><d_gain>800</d_gain>
      <cmd_max>3000</cmd_max><cmd_min>-3000</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>track_lift_left</joint_name>
      <topic>/model/mana_chair/joint/track_lift_left/cmd_pos</topic>
      <p_gain>20000</p_gain><i_gain>0</i_gain><d_gain>800</d_gain>
      <cmd_max>3000</cmd_max><cmd_min>-3000</cmd_min>
      <initial_position>0.15</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>track_lift_right</joint_name>
      <topic>/model/mana_chair/joint/track_lift_right/cmd_pos</topic>
      <p_gain>20000</p_gain><i_gain>0</i_gain><d_gain>800</d_gain>
      <cmd_max>3000</cmd_max><cmd_min>-3000</cmd_min>
      <initial_position>0.15</initial_position>
    </plugin>

    <!-- wheels mode: differential drive on the four wheels -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_fl_joint</left_joint>
      <left_joint>wheel_rl_joint</left_joint>
      <right_joint>wheel_fr_joint</right_joint>
      <right_joint>wheel_rr_joint</right_joint>
      <wheel_separation>0.7</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/model/mana_chair/wheels_cmd_vel</topic>
      <odom_topic>/model/mana_chair/wheels_odom</odom_topic>
      <max_linear_velocity>1.5</max_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_linear_acceleration>-3</min_linear_acceleration>
      <max_linear_acceleration>3</max_linear_acceleration>
    </plugin>

    <!-- tracks mode: tracked vehicle on the two tracks -->
    <plugin filename="gz-sim-tracked-vehicle-system" name="gz::sim::systems::TrackedVehicle">
      <left_track><link>left_track</link></left_track>
      <right_track><link>right_track</link></right_track>
      <tracks_separation>0.48</tracks_separation>
      <tracks_height>0.18</tracks_height>
      <steering_efficiency>0.5</steering_efficiency>
      <topic>/model/mana_chair/tracks_cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>left_track</link>
      <min_velocity>-1.5</min_velocity>
      <max_velocity>1.5</max_velocity>
    </plugin>
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>right_track</link>
      <min_velocity>-1.5</min_velocity>
      <max_velocity>1.5</max_velocity>
    </plugin>

    <!-- where the chair is -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>chassis</robot_base_frame>
      <odom_topic>/model/mana_chair/ground_truth</odom_topic>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
