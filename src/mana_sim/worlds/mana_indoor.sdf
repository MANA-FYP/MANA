<?xml version="1.0"?>
<!--
  MANA indoor test world (#43): a floor of 16 x 10 m with a corridor loop round a central block,
  for the lidar localisation. The corridors are 2.75 m (south and north), 3 m (west) and 2 m (east)
  wide, and cabinets and a pillar stand along the walls at irregular places, so that no two places
  look the same to the lidar. Walls are 1.5 m high. There is no GPS indoors: the NavSat system is
  left out, so the position comes from the lidar map. The chair starts in the south corridor at
  x = 1 m, facing east.
-->
<sdf version="1.9">
  <world name="mana_indoor">
    <physics name="4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="building">
      <static>true</static>
      <link name="walls">
        <collision name="floor"><pose>8 5 -0.05 0 0 0</pose>
          <geometry><box><size>16 10 0.1</size></box></geometry></collision>
        <visual name="floor"><pose>8 5 -0.05 0 0 0</pose>
          <geometry><box><size>16 10 0.1</size></box></geometry>
          <material><ambient>0.55 0.6 0.55 1</ambient><diffuse>0.6 0.7 0.6 1</diffuse></material></visual>
        <collision name="wall_south"><pose>8 -0.1 0.75 0 0 0</pose><geometry><box><size>16.4 0.2 1.5</size></box></geometry></collision>
        <visual name="wall_south"><pose>8 -0.1 0.75 0 0 0</pose><geometry><box><size>16.4 0.2 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="wall_north"><pose>8 10.1 0.75 0 0 0</pose><geometry><box><size>16.4 0.2 1.5</size></box></geometry></collision>
        <visual name="wall_north"><pose>8 10.1 0.75 0 0 0</pose><geometry><box><size>16.4 0.2 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="wall_west"><pose>-0.1 5 0.75 0 0 0</pose><geometry><box><size>0.2 10 1.5</size></box></geometry></collision>
        <visual name="wall_west"><pose>-0.1 5 0.75 0 0 0</pose><geometry><box><size>0.2 10 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="wall_east"><pose>16.1 5 0.75 0 0 0</pose><geometry><box><size>0.2 10 1.5</size></box></geometry></collision>
        <visual name="wall_east"><pose>16.1 5 0.75 0 0 0</pose><geometry><box><size>0.2 10 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="block"><pose>8.5 5 0.75 0 0 0</pose><geometry><box><size>11 4.5 1.5</size></box></geometry></collision>
        <visual name="block"><pose>8.5 5 0.75 0 0 0</pose><geometry><box><size>11 4.5 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="cabinet_1"><pose>5 0.3 0.75 0 0 0</pose><geometry><box><size>1.2 0.6 1.5</size></box></geometry></collision>
        <visual name="cabinet_1"><pose>5 0.3 0.75 0 0 0</pose><geometry><box><size>1.2 0.6 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="cabinet_2"><pose>11.5 0.3 0.75 0 0 0</pose><geometry><box><size>0.8 0.6 1.5</size></box></geometry></collision>
        <visual name="cabinet_2"><pose>11.5 0.3 0.75 0 0 0</pose><geometry><box><size>0.8 0.6 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="cabinet_3"><pose>15.7 4 0.75 0 0 0</pose><geometry><box><size>0.6 1.5 1.5</size></box></geometry></collision>
        <visual name="cabinet_3"><pose>15.7 4 0.75 0 0 0</pose><geometry><box><size>0.6 1.5 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="cabinet_4"><pose>9 9.7 0.75 0 0 0</pose><geometry><box><size>2 0.6 1.5</size></box></geometry></collision>
        <visual name="cabinet_4"><pose>9 9.7 0.75 0 0 0</pose><geometry><box><size>2 0.6 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="cabinet_5"><pose>0.3 7.5 0.75 0 0 0</pose><geometry><box><size>0.6 1 1.5</size></box></geometry></collision>
        <visual name="cabinet_5"><pose>0.3 7.5 0.75 0 0 0</pose><geometry><box><size>0.6 1 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
        <collision name="pillar"><pose>2.2 9.2 0.75 0 0 0</pose><geometry><box><size>0.4 0.4 1.5</size></box></geometry></collision>
        <visual name="pillar"><pose>2.2 9.2 0.75 0 0 0</pose><geometry><box><size>0.4 0.4 1.5</size></box></geometry>
          <material><ambient>0.75 0.72 0.65 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- the test host, 1 m from the west wall, in the middle of the south corridor -->
    <include>
      <uri>model://mana_chair</uri>
      <name>mana_chair</name>
      <pose>1 1.375 0.38 0 0 0</pose>
    </include>
  </world>
</sdf>
