<?xml version="1.0"?>
<!--
  MANA open test world (#79): a small campus with every hazard, made by mana_sim/campus.py
  (python -m mana_sim.campus, seed None). Do not edit by hand.

  Steps 0.17 m, curb 0.12 m, entrance ramp 4.8 deg,
  terrace ramp 7.0 deg, drop 1.0 m, sun 0.9, floor shade 0.0.
  Heights: street 0, plaza 0.12, building floor 0.63, terrace 1.12.

  Start poses (the chair stands at plaza; the start option of mana_sim.campus picks another):
    plaza                          x   -2.00  y    2.00  yaw  1.571  ground 0.120
    street                         x   -4.00  y  -11.00  yaw  1.571  ground 0.000
    before_curb_cut                x   21.00  y  -11.00  yaw  1.571  ground 0.000
    before_steps                   x   10.00  y    1.00  yaw  1.571  ground 0.120
    before_entrance_ramp           x   14.00  y   -3.07  yaw  1.571  ground 0.120
    lobby                          x   12.00  y    9.00  yaw  1.571  ground 0.630
    corridor                       x    2.00  y   15.50  yaw  0.000  ground 0.630
    outside_dark_room              x    8.00  y    9.50  yaw  3.142  ground 0.630
    hall                           x   18.00  y   21.00  yaw  1.571  ground 0.630
    behind_building                x   18.00  y   31.00  yaw -1.571  ground 0.120
    before_terrace_ramp            x  -19.00  y   -5.00  yaw  1.571  ground 0.120
    terrace                        x  -19.00  y   13.00  yaw  1.571  ground 1.120
    scenario_level                 x   -2.00  y    2.00  yaw  1.571  ground 0.120
    scenario_ramp                  x   14.00  y   -3.07  yaw  1.571  ground 0.120
    scenario_stairs                x   10.00  y    1.00  yaw  1.571  ground 0.120
    scenario_curb                  x   -4.00  y  -11.00  yaw  1.571  ground 0.000
    scenario_stop                  x   -2.00  y    2.00  yaw  1.571  ground 0.120
    scenario_drop                  x  -19.00  y   13.00  yaw  1.571  ground 1.120
    scenario_manual_drop           x  -19.00  y   13.00  yaw  1.571  ground 1.120
    scenario_picture               x   -2.00  y    2.00  yaw  1.571  ground 0.120
    scenario_dark                  x    8.00  y    9.50  yaw  3.142  ground 0.630
    scenario_imu_lost              x   10.00  y    1.00  yaw  1.571  ground 0.120

  Zones, for the faults (#15) to switch:
    indoors      x 0 to 24, y 6 to 26
    dark_room    x 0 to 6, y 6 to 14
    weak_wifi    x 0 to 24, y 17 to 26
-->
<sdf version="1.9">
  <world name="mana_campus">
    <physics name="4ms" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <!-- the chair's sensors: cameras and lidar need rendering, IMU and GPS do not -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- a made-up place, only so that the GPS has a position (as worlds/mana_route.sdf) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>33.6844</latitude_deg>
      <longitude_deg>73.0479</longitude_deg>
      <elevation>540</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <gravity>0 0 -9.81</gravity>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.85 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="campus">
      <static>true</static>
      <link name="ground">
        <collision name="street"><pose>0 -11 -0.05 0 0 0</pose><geometry><box><size>70 10 0.1</size></box></geometry></collision>
        <visual name="street"><pose>0 -11 -0.05 0 0 0</pose><geometry><box><size>70 10 0.1</size></box></geometry><material><ambient>0.256 0.256 0.272 1</ambient><diffuse>0.32 0.32 0.34 1</diffuse></material></visual>
        <collision name="plaza"><pose>0 14 0.01 0 0 0</pose><geometry><box><size>70 40 0.22</size></box></geometry></collision>
