        <visual name="curb_edge"><pose>0 -6.05 0.06 0 0 0</pose><geometry><box><size>70 0.1 0.12</size></box></geometry><material><ambient>0.64 0.64 0.64 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
