<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mana_perception</name>
  <version>0.1.0</version>
  <description>MANA perception (M1 Vision): ground reports from the 3D camera, and a scripted stub on the real message interface.</description>
  <maintainer email="waqasmalik0007@users.noreply.github.com">Muhammad Waqas</maintainer>
  <license>AGPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>mana_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
